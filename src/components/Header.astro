---
import { SITE } from '../data/site';

const path = Astro.url.pathname;
const nav = [
  { href: '/', label: '首页', match: (p: string) => p === '/' },
  { href: '/blog/', label: '文章', match: (p: string) => p.startsWith('/blog') },
  { href: '/projects/', label: '项目', match: (p: string) => p.startsWith('/projects') },
  { href: '/members/', label: '成员', match: (p: string) => p.startsWith('/members') },
  { href: '/about/', label: '关于', match: (p: string) => p.startsWith('/about') },
];
---

<header class="sticky top-0 z-50 px-4 pt-4 sm:px-6">
  <div
    class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-6 rounded-full border bg-white/65 px-5 backdrop-blur-xl sm:px-7"
    style="border-color: rgba(255, 255, 255, 0.75); box-shadow: 0 8px 32px -16px rgba(32, 31, 36, 0.2);"
  >
    <a href="/" class="flex items-center gap-3">
      <img src="/images/logo.png" alt="The Brotherhood of SCU 徽记" width="36" height="36" class="size-9 object-contain" />
      <span class="leading-tight">
        <span class="block font-serif text-sm font-bold tracking-wide">{SITE.name}</span>
        <span class="block font-mono text-[10px] tracking-[0.2em] text-ink-faint">{SITE.nameZh}</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', item.match(path) && 'text-crimson']}
            aria-current={item.match(path) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={SITE.github}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 text-sm text-ink-soft transition-colors hover:text-crimson"
        aria-label="GitHub 组织"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
        GitHub
      </a>
    </nav>

    <details class="relative md:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-1 text-sm text-ink-soft select-none">
        <span class="font-mono text-xs tracking-widest">MENU</span>
      </summary>
      <nav
        class="absolute top-full right-0 mt-3 w-44 rounded-2xl border bg-white/85 py-2 shadow-[0_20px_50px_-20px_rgba(32,31,36,0.35)] backdrop-blur-xl"
        style="border-color: rgba(255, 255, 255, 0.8);"
        aria-label="移动端导航"
      >
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'block px-5 py-2 text-sm transition-colors hover:text-crimson',
                item.match(path) ? 'text-crimson' : 'text-ink-soft',
              ]}
            >
              {item.label}
            </a>
          ))
        }
        <a
          href={SITE.github}
          target="_blank"
          rel="noopener noreferrer"
          class="block px-5 py-2 text-sm text-ink-soft transition-colors hover:text-crimson">GitHub ↗</a
        >
      </nav>
    </details>
  </div>
</header>
