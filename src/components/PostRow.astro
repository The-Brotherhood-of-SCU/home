---
import { formatDate } from '../data/site';

interface Props {
  title: string;
  date: Date;
  description?: string;
  tags?: string[];
  href: string;
}

const { title, date, description, tags = [], href } = Astro.props;
---

<a href={href} class="group block border-b border-line py-7">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:gap-8">
    <time datetime={date.toISOString()} class="shrink-0 font-mono text-xs text-ink-faint sm:pt-1.5">
      {formatDate(date)}
    </time>
    <div>
      <h3 class="font-serif text-xl font-bold transition-colors group-hover:text-crimson sm:text-2xl">{title}</h3>
      {
        description && (
          <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-soft">
            {description}
          </p>
        )
      }
      {
        tags.length > 0 && (
          <p class="mt-3 flex flex-wrap gap-2">
            {tags.map((t) => (
              <span class="border border-line px-2 py-0.5 font-mono text-[11px] text-ink-faint">{t}</span>
            ))}
          </p>
        )
      }
    </div>
  </div>
</a>
