---
import { formatDate } from '../data/site';

interface Props {
  title: string;
  date: Date;
  description?: string;
  tags?: string[];
  href: string;
  /** 渐显延迟（毫秒），用于列表错峰入场 */
  delay?: number;
}

const { title, date, description, tags = [], href, delay = 0 } = Astro.props;
---

<a href={href} class="glass-card group block p-6 sm:p-7" data-reveal style={`--reveal-delay: ${delay}ms`}>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:gap-8">
    <time datetime={date.toISOString()} class="shrink-0 font-mono text-xs text-ink-faint sm:pt-1.5">
      {formatDate(date)}
    </time>
    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-4">
        <h3 class="font-serif text-xl font-bold transition-colors duration-300 group-hover:text-crimson sm:text-2xl">
          {title}
        </h3>
        <span
          class="mt-1 shrink-0 font-mono text-sm text-ink-faint transition-all duration-300 group-hover:translate-x-1 group-hover:text-crimson"
          aria-hidden="true"
        >
          →
        </span>
      </div>
      {
        description && (
          <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-soft">
            {description}
          </p>
        )
      }
      {
        tags.length > 0 && (
          <p class="mt-3 flex flex-wrap gap-2">
            {tags.map((t) => (
              <span class="glass-chip !px-2.5 !py-0.5 normal-case">{t}</span>
            ))}
          </p>
        )
      }
    </div>
  </div>
</a>
