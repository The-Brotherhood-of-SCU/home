---
interface Props {
  name: string;
  en: string;
  description: string;
  link: string;
  cover?: string;
  class?: string;
}

const { name, en, description, link, cover, class: className } = Astro.props;
---

<a href={link} target="_blank" rel="noopener noreferrer" class:list={['glass-card group flex flex-col overflow-hidden', className]}>
  {
    cover ? (
      <div class="relative aspect-16/10 overflow-hidden">
        <img
          src={cover}
          alt={`${name} 预览图`}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.06]"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-crimson/0 to-crimson/0 transition-colors duration-500 group-hover:from-crimson/15"
          aria-hidden="true"
        ></div>
      </div>
    ) : (
      <div
        class="relative flex aspect-16/10 items-center justify-center overflow-hidden bg-gradient-to-br from-aurora-red/10 via-aurora-violet/10 to-aurora-blue/10"
      >
        <div
          class="absolute -top-10 -right-10 size-40 rounded-full bg-aurora-violet/20 blur-3xl transition-transform duration-700 group-hover:scale-125"
          aria-hidden="true"
        ></div>
        <span class="relative font-serif text-2xl font-bold text-ink/70 transition-colors duration-500 group-hover:text-crimson">
          {name}
        </span>
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="font-serif text-lg font-bold">{name}</h3>
      <span class="truncate font-mono text-[11px] text-ink-faint">{en}</span>
    </div>
    <p class="mt-2.5 flex-1 text-sm leading-relaxed text-ink-soft">{description}</p>
    <span
      class="mt-5 inline-flex items-center gap-1 font-mono text-[11px] tracking-widest text-ink-faint transition-colors duration-300 group-hover:text-crimson"
    >
      GITHUB
      <span class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
    </span>
  </div>
</a>
