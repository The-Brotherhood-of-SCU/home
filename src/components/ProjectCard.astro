---
interface Props {
  name: string;
  en: string;
  description: string;
  link: string;
  cover?: string;
}

const { name, en, description, link, cover } = Astro.props;
---

<a href={link} target="_blank" rel="noopener noreferrer" class="hairline-card group flex flex-col">
  {
    cover ? (
      <div class="aspect-16/10 overflow-hidden border-b border-line bg-paper-deep">
        <img
          src={cover}
          alt={`${name} 预览图`}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
        />
      </div>
    ) : (
      <div class="flex aspect-16/10 items-center justify-center border-b border-line bg-paper-deep px-6">
        <span class="font-serif text-2xl font-bold text-ink/70 transition-colors group-hover:text-crimson">{name}</span>
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="font-serif text-lg font-bold">{name}</h3>
      <span class="truncate font-mono text-[11px] text-ink-faint">{en}</span>
    </div>
    <p class="mt-2.5 flex-1 text-sm leading-relaxed text-ink-soft">{description}</p>
    <span class="mt-5 font-mono text-[11px] tracking-widest text-ink-faint transition-colors group-hover:text-crimson">
      GITHUB ↗
    </span>
  </div>
</a>
