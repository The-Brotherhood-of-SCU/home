---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { SITE, CONCEPTS, CODE_OF_CONDUCT, QUOTES } from '../data/site';
---

<Base title="关于我们" description={SITE.description}>
  <section class="wrap pt-14 sm:pt-20">
    <p class="glass-chip" data-reveal>About Us</p>
    <h1 class="mt-7 font-serif text-4xl font-black tracking-wide sm:text-5xl" data-reveal style="--reveal-delay: 120ms">
      关于我们<span class="text-gradient">。</span>
    </h1>
  </section>

  <section class="wrap pt-16">
    <div class="grid gap-10 lg:grid-cols-[1.5fr_1fr] lg:gap-12">
      <div class="prose-book max-w-none" data-reveal>
        <p>
          <strong>The Brotherhood of SCU</strong> 是一个由四川大学在校生及校友自发组织的开发者社区。
          我们致力于打破信息隔阂，构建一个纯粹、自由、富有创造力的开源生态空间。
        </p>
        <p>
          社区以「代码为纽带 · 创新为信仰 · 社区为家园」为信条：从教务系统插件到课表应用，
          从抢课脚本到论文模板，我们把自己在川大生活学习中踩过的坑，变成所有人都能用的工具。
        </p>
        <p class="font-serif text-lg leading-loose text-ink">
          「海纳百川，有容乃大；<br />川流不息，代码为舟。」
        </p>
      </div>
      <aside class="glass-card h-fit p-7 lg:mt-2" data-reveal style="--reveal-delay: 150ms">
        <p class="font-mono text-xs tracking-[0.25em] text-ink-faint uppercase">Info</p>
        <dl class="mt-4 space-y-4 text-sm">
          <div>
            <dt class="font-mono text-[11px] tracking-widest text-crimson">NAME</dt>
            <dd class="mt-1">The Brotherhood of SCU<br /><span class="text-ink-soft">四川大学开源社区（非官方）</span></dd>
          </div>
          <div>
            <dt class="font-mono text-[11px] tracking-widest text-crimson">FOUNDED</dt>
            <dd class="mt-1">由川大在校生与校友发起</dd>
          </div>
          <div>
            <dt class="font-mono text-[11px] tracking-widest text-crimson">CONTACT</dt>
            <dd class="mt-1">
              <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="u-link">GitHub 组织 ↗</a><br />
              <a href={`mailto:${SITE.email}`} class="u-link">邮件联系</a><br />
              <a href={SITE.discord} target="_blank" rel="noopener noreferrer" class="u-link">Discord 频道 ↗</a>
            </dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="wrap pt-24">
    <SectionHeader no="01" title="我们的理念" />
    <div class="grid gap-5 md:grid-cols-3 md:gap-6">
      {
        CONCEPTS.map((c, i) => (
          <div class="glass-card p-7 sm:p-8" data-reveal style={`--reveal-delay: ${i * 100}ms`}>
            <span class="text-gradient font-serif text-3xl font-black">{c.no}</span>
            <h3 class="mt-4 font-serif text-xl font-bold">{c.name}</h3>
            <p class="mt-3 text-sm leading-loose text-ink-soft">{c.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap pt-24">
    <SectionHeader no="02" title="行为准则" />
    <div class="grid gap-5 sm:grid-cols-2">
      {
        CODE_OF_CONDUCT.map((c, i) => (
          <div class="glass-lite p-7" data-reveal style={`--reveal-delay: ${(i % 2) * 90}ms`}>
            <h3 class="flex items-center gap-2.5 font-serif text-lg font-bold">
              <span
                class="flex size-6 items-center justify-center rounded-full bg-gradient-to-br from-crimson to-aurora-gold font-sans text-[11px] text-white"
                aria-hidden="true"
              >
                ✓
              </span>
              {c.title}
            </h3>
            <p class="mt-2.5 text-sm leading-relaxed text-ink-soft">{c.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap pt-24">
    <SectionHeader no="03" title="墙上的话" />
    <div class="columns-1 gap-5 sm:columns-2">
      {
        QUOTES.map((q, i) => (
          <figure
            class="glass-card mb-5 break-inside-avoid p-7"
            data-reveal
            style={`--reveal-delay: ${(i % 2) * 90}ms`}
          >
            <blockquote class="font-serif text-lg leading-loose">「{q.words}」</blockquote>
            <figcaption class="mt-3 font-mono text-[11px] tracking-widest text-ink-faint">—— {q.name}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>
</Base>
