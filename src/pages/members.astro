---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { MEMBERS, ADMINS, SITE } from '../data/site';

const members = MEMBERS.filter((m) => m.role !== 'ADMIN');
---

<Base title="成员名录" description="The Brotherhood of SCU 的成员名录：一群热爱技术的川大人。">
  <section class="wrap pt-14 sm:pt-20">
    <p class="glass-chip" data-reveal>Members</p>
    <h1 class="mt-7 font-serif text-4xl font-black tracking-wide sm:text-5xl" data-reveal style="--reveal-delay: 120ms">
      成员名录<span class="text-gradient">。</span>
    </h1>
    <p class="mt-6 max-w-xl text-sm leading-loose text-ink-soft" data-reveal style="--reveal-delay: 220ms">
      一群热爱技术的川大人，来自不同学院、不同年级，共 {MEMBERS.length} 人。
      <span class="mx-1 inline-block size-1.5 rounded-full bg-crimson align-middle" aria-hidden="true"></span>
      为社区核心成员。
    </p>
  </section>

  <section class="wrap pt-16">
    <SectionHeader no="01" title={`核心成员 · ${ADMINS.length}`} />
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        ADMINS.map((m, i) => (
          <div class="glass-card group p-6" data-reveal style={`--reveal-delay: ${(i % 3) * 80}ms`}>
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <span class="shrink-0 rounded-full bg-gradient-to-br from-crimson to-aurora-gold p-[2px]">
                  <img
                    src={`https://github.com/${m.login}.png?size=80`}
                    alt={`${m.name} 的头像`}
                    loading="lazy"
                    decoding="async"
                    class="size-12 rounded-full border border-white/80 object-cover dark:border-white/15"
                  />
                </span>
                <div>
                  <p class="font-serif text-lg font-bold">{m.name}</p>
                  <p class="font-mono text-xs text-ink-faint">@{m.login}</p>
                </div>
              </div>
              <span class="font-mono text-[10px] tracking-widest text-crimson">ADMIN</span>
            </div>
            {m.bio && <p class="mt-4 text-sm leading-relaxed text-ink-soft">{m.bio}</p>}
            <a
              href={`https://github.com/${m.login}`}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-1 font-mono text-[11px] tracking-widest text-ink-faint transition-colors hover:text-crimson"
            >
              GITHUB <span class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap pt-24">
    <SectionHeader no="02" title={`社区成员 · ${members.length}`} />
    <div class="columns-1 gap-4 sm:columns-2 lg:columns-3">
      {
        members.map((m, i) => (
          <a
            href={`https://github.com/${m.login}`}
            target="_blank"
            rel="noopener noreferrer"
            class="glass-lite group mb-4 flex break-inside-avoid items-baseline justify-between gap-3 px-5 py-3.5"
            data-reveal
            style={`--reveal-delay: ${Math.min(i, 8) * 40}ms`}
          >
            <span class="flex min-w-0 items-baseline gap-2">
              <span class="font-serif font-bold transition-colors group-hover:text-crimson">{m.name}</span>
              <span class="truncate font-mono text-xs text-ink-faint">@{m.login}</span>
            </span>
            <span
              class="shrink-0 font-mono text-[11px] text-ink-faint transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-crimson"
            >
              ↗
            </span>
          </a>
        ))
      }
    </div>
    <p class="mt-8 font-mono text-xs text-ink-faint" data-reveal>
      想加入？在
      <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-crimson">GitHub</a>
      上找到我们，或来
      <a href={SITE.discord} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-crimson">Discord 频道</a>
      聊聊。
    </p>
  </section>
</Base>
