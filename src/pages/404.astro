---
import Base from '../layouts/Base.astro';
---

<Base title="404" description="页面不存在">
  <section class="wrap flex flex-col items-center py-32 text-center sm:py-44">
    <p class="font-serif text-8xl font-black text-crimson sm:text-9xl">404</p>
    <p class="mt-6 font-serif text-2xl font-bold">此页不在川上<span class="text-crimson">。</span></p>
    <p class="mt-4 text-sm text-ink-soft">你要找的页面可能已被江水冲走，或从未存在过。</p>
    <a href="/" class="mt-10 border border-ink/60 px-7 py-3 text-sm transition-colors hover:border-crimson hover:text-crimson">
      回到首页
    </a>
  </section>
</Base>
