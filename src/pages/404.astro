---
import Base from '../layouts/Base.astro';
---

<Base title="404" description="页面不存在">
  <section class="wrap flex flex-col items-center py-32 text-center sm:py-44">
    <div class="glass-card relative w-full max-w-xl overflow-hidden px-8 py-16 sm:py-20" data-reveal>
      <div class="absolute -top-20 -left-16 size-56 rounded-full bg-crimson/15 blur-3xl" aria-hidden="true"></div>
      <div class="absolute -right-16 -bottom-24 size-64 rounded-full bg-aurora-blue/20 blur-3xl" aria-hidden="true"></div>
      <p class="text-gradient relative font-serif text-8xl font-black sm:text-9xl">404</p>
      <p class="relative mt-6 font-serif text-2xl font-bold">此页不在川上<span class="text-crimson">。</span></p>
      <p class="relative mt-4 text-sm text-ink-soft">你要找的页面可能已被江水冲走，或从未存在过。</p>
      <a href="/" class="btn-primary relative mt-10">
        回到首页
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>
