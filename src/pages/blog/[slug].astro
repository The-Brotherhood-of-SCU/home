---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE, formatDate } from '../../data/site';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: i > 0 ? posts[i - 1] : undefined,
      older: i < posts.length - 1 ? posts[i + 1] : undefined,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, date, author, tags } = post.data;
---

<Base title={title} description={description ?? `${title} — ${SITE.name} 社区博客`}>
  <article class="wrap pt-12 sm:pt-16">
    <header class="mx-auto max-w-[44rem]">
      <p data-reveal>
        <a
          href="/blog/"
          class="glass-chip !px-3.5 !py-1 transition-colors hover:text-crimson"
        >
          ← 文章
        </a>
      </p>
      <h1
        class="mt-7 font-serif text-3xl leading-snug font-black tracking-wide sm:text-4xl"
        data-reveal
        style="--reveal-delay: 100ms"
      >
        {title}
      </h1>
      <div
        class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 pb-8 font-mono text-xs text-ink-faint"
        data-reveal
        style="--reveal-delay: 200ms"
      >
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span>文 / {author}</span>
        {
          tags.length > 0 && (
            <span class="flex gap-2">
              {tags.map((t) => (
                <span class="text-crimson">#{t}</span>
              ))}
            </span>
          )
        }
      </div>
      <div class="g-line" data-reveal style="--reveal-delay: 260ms"></div>
    </header>

    <div class="prose-book mx-auto mt-4 max-w-[44rem]" data-reveal style="--reveal-delay: 300ms">
      <Content />
    </div>

    <footer class="mx-auto mt-20 max-w-[44rem]">
      <div class="grid gap-4 sm:grid-cols-2">
        {
          older ? (
            <a href={`/blog/${older.id}/`} class="glass-card p-6">
              <p class="font-mono text-[11px] tracking-widest text-ink-faint">← 较早一篇</p>
              <p class="mt-2 font-serif font-bold leading-snug">{older.data.title}</p>
            </a>
          ) : (
            <div class="glass-card p-6 text-ink-faint">
              <p class="font-mono text-[11px] tracking-widest">已是第一篇</p>
            </div>
          )
        }
        {
          newer ? (
            <a href={`/blog/${newer.id}/`} class="glass-card p-6 text-right">
              <p class="font-mono text-[11px] tracking-widest text-ink-faint">较新一篇 →</p>
              <p class="mt-2 font-serif font-bold leading-snug">{newer.data.title}</p>
            </a>
          ) : (
            <div class="glass-card p-6 text-right text-ink-faint">
              <p class="font-mono text-[11px] tracking-widest">已是最新一篇</p>
            </div>
          )
        }
      </div>
    </footer>
  </article>

  <!-- 图片灯箱：点击正文图片放大查看 -->
  <div class="lightbox" id="lightbox" hidden>
    <button class="lightbox__close" type="button" aria-label="关闭图片预览">×</button>
    <figure class="lightbox__figure">
      <img class="lightbox__img" src="" alt="" />
      <figcaption class="lightbox__caption"></figcaption>
    </figure>
  </div>
</Base>

<script>
  const lightbox = document.getElementById('lightbox') as HTMLDivElement | null;
  if (lightbox) {
    const imgEl = lightbox.querySelector<HTMLImageElement>('.lightbox__img')!;
    const captionEl = lightbox.querySelector<HTMLElement>('.lightbox__caption')!;
    const closeBtn = lightbox.querySelector<HTMLButtonElement>('.lightbox__close')!;

    let hideTimer: ReturnType<typeof setTimeout> | undefined;

    const open = (img: HTMLImageElement) => {
      clearTimeout(hideTimer);
      lightbox.removeEventListener('transitionend', onFadeEnd);
      imgEl.src = img.currentSrc || img.src;
      imgEl.alt = img.alt;
      captionEl.textContent = img.alt;
      captionEl.hidden = !img.alt;
      lightbox.hidden = false;
      requestAnimationFrame(() => lightbox.classList.add('is-open'));
      document.documentElement.style.overflow = 'hidden';
      closeBtn.focus();
    };

    // 过渡在遮罩（opacity）和 figure（transform）上，只有遮罩自身的 opacity 结束才算关完
    const hide = () => {
      lightbox.hidden = true;
      imgEl.src = '';
    };
    const onFadeEnd = (e: TransitionEvent) => {
      if (e.target !== lightbox || e.propertyName !== 'opacity') return;
      lightbox.removeEventListener('transitionend', onFadeEnd);
      hide();
    };

    const close = () => {
      lightbox.classList.remove('is-open');
      document.documentElement.style.overflow = '';
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        hide();
      } else {
        lightbox.addEventListener('transitionend', onFadeEnd);
        // 兜底：过渡未触发（如标签页被切走）时也能复位
        hideTimer = setTimeout(hide, 300);
      }
    };

    // 只接管未套链接的正文图片，避免破坏原有的图片跳转
    document.querySelectorAll<HTMLImageElement>('.prose-book img').forEach((img) => {
      if (img.closest('a')) return;
      img.classList.add('zoomable');
      img.addEventListener('click', () => open(img));
    });

    closeBtn.addEventListener('click', close);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox.hidden) close();
    });
  }
</script>
