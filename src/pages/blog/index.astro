---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const y = post.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Base title="文章" description="The Brotherhood of SCU 社区博客：记录我们的开发、思考与校园生活。">
  <section class="wrap pt-14 sm:pt-20">
    <p class="glass-chip" data-reveal>Blog · Blog of The Developers</p>
    <h1
      class="mt-7 font-serif text-4xl font-black tracking-wide sm:text-5xl"
      data-reveal
      style="--reveal-delay: 120ms"
    >
      文章<span class="text-gradient">。</span>
    </h1>
    <p class="mt-6 max-w-xl text-sm leading-loose text-ink-soft" data-reveal style="--reveal-delay: 220ms">
      记录社区项目的开发历程、技术思考，以及川大校园里的那些事。共 {posts.length} 篇。
    </p>
  </section>

  {
    years.map((year, yi) => (
      <section class="wrap pt-16">
        <div class="flex items-baseline gap-4" data-reveal>
          <span class="text-gradient font-serif text-2xl font-black">{year}</span>
          <span class="font-mono text-xs text-ink-faint">{byYear.get(year)!.length} 篇</span>
        </div>
        <div class="g-line mt-3 mb-5" data-reveal />
        <div class="space-y-4">
          {byYear.get(year)!.map((post, i) => (
            <PostRow
              title={post.data.title}
              date={post.data.date}
              description={post.data.description}
              tags={post.data.tags}
              href={`/blog/${post.id}/`}
              delay={Math.min(i, 5) * 60}
            />
          ))}
        </div>
      </section>
    ))
  }
</Base>
